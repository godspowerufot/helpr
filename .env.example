NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WORKSPACE_MODE=multi
NEXT_PUBLIC_WORKSPACE_STRATEGY=path
NEXT_PUBLIC_ACCESS_TOKEN_KEY=helpr_access_token
NEXT_PUBLIC_DEFAULT_TENANT=demo

# true = serve Helpr endpoints from api/mock.api.ts (auth stays real)
NEXT_PUBLIC_USE_MOCK_API=true
# Google sign-in returns here (must match backend GOOGLE_REDIRECT_URI and the Google console).
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/login
